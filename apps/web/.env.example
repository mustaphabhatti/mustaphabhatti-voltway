# Where the Next.js server proxies /api/* (the Fastify API)
API_URL=http://localhost:4000
# Optional: browser WebSocket endpoint. Default: same origin (/ws, proxied to the API)
# NEXT_PUBLIC_WS_URL=
# Optional: Mapbox public token (pk.*) for Mapbox map tiles. Without it, OpenStreetMap/CARTO tiles are used.
NEXT_PUBLIC_MAPBOX_TOKEN=
