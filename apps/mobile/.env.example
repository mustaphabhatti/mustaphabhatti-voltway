# Voltway API base URL reachable from the phone/emulator.
# Android emulator → http://10.0.2.2:4000 · iOS simulator → http://localhost:4000 · real device → http://<your-LAN-IP>:4000
EXPO_PUBLIC_API_URL=http://10.0.2.2:4000
# Required for Google Maps on Android builds (Expo Go works without it during development)
GOOGLE_MAPS_ANDROID_API_KEY=
