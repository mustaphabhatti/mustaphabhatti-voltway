# ── Core ──────────────────────────────────────────────
PORT=4000
DATABASE_URL=postgresql://evcharge:evcharge@localhost:5432/evcharge
# Long random string — used to sign session tokens
JWT_SECRET=change-me-to-a-long-random-string
# Origin of the web app (CORS + OAuth redirects)
WEB_ORIGIN=http://localhost:3000
# Public URL of this API (used for OAuth callbacks & upload URLs). With the Next.js proxy this is the web origin.
PUBLIC_API_URL=http://localhost:3000

# ── Demo mode ─────────────────────────────────────────
# Runs the built-in charger simulator for stations with integration_type=simulator.
# Simulated data is always labelled "Demo feed (simulated)" — never "Live".
DEMO_SIMULATOR=true
# Speeds up simulated charging sessions (1 = real time)
DEMO_SESSION_SPEED=30

# ── Maps / routing / geocoding ────────────────────────
# auto = Mapbox if MAPBOX_TOKEN set, else OSRM, falling back to the offline road graph
ROUTING_PROVIDER=auto
OSRM_URL=https://router.project-osrm.org
GEOCODER=auto
NOMINATIM_URL=https://nominatim.openstreetmap.org
MAPBOX_TOKEN=

# ── Social login (optional) ───────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
# PKCS8 private key (\n-escaped)
APPLE_PRIVATE_KEY=

# ── Payments (optional) ───────────────────────────────
# demo | stripe
PAYMENT_PROVIDER=demo
STRIPE_SECRET_KEY=

# ── OCPP central system ───────────────────────────────
# Accept unknown charge point identities on BootNotification (dev only)
OCPP_AUTO_ACCEPT=false
